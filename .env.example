# Copie para .env se quiser mudar algo (todos são opcionais)
WEB_PORT=8080
DB_NAME=fatecpoll
DB_USER=fatecpoll
DB_PASS=fatecpoll
DB_ROOT_PASSWORD=root
ADMIN_EMAIL=admin@fatecpoll.local
ADMIN_PASSWORD=admin123
SEED_DEMO=1
APP_DEBUG=1

# Link público das enquetes (em produção, coloque o endereço real do site)
APP_URL=

# Voto único por dispositivo
# Chave secreta que assina o identificador do dispositivo. Vazio = cria storage/app.key automaticamente.
# IMPORTANTE: guarde a chave e NUNCA a troque: trocar invalida as identidades e libera novos votos.
APP_KEY=
# O que fazer quando um aparelho "novo" repete o fingerprint + a rede de quem já votou: flag (marca como suspeito) ou block (recusa)
DUPLICATE_SIGNAL=flag

# E-mail (código de verificação). Padrão no Docker: Mailpit em http://localhost:8025
# Para enviar de verdade, troque por um servidor SMTP, por exemplo:
#MAIL_DRIVER=smtp
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_SECURE=tls
#SMTP_USER=seu-usuario@gmail.com
#SMTP_PASS=senha-de-app
#MAIL_FROM=seu-usuario@gmail.com
#MAIL_FROM_NAME=FatecPoll
